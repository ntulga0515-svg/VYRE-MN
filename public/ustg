}
@keyframes floaty{ 50%{ transform:translateY(-9px) rotate(6deg); } }
.empty-clans strong{ font-family:var(--display); font-size:15px; letter-spacing:-.01em; color:#fff; }

/* =========================================================
   PROFILE
   ========================================================= */

.profile-hero{
  min-height:220px; padding:clamp(24px,3.4vw,42px); border-radius:24px; overflow:hidden; gap:clamp(20px,3vw,36px);
  background:
    radial-gradient(ellipse 60% 120% at 0 0,rgba(255,51,71,.2),transparent 60%),
    radial-gradient(ellipse 60% 120% at 100% 100%,rgba(47,123,255,.22),transparent 60%),
    var(--panel-solid);
  border:1px solid var(--line-2);
}
.profile-hero::before{
  content:""; position:absolute; inset:0; opacity:.5; pointer-events:none;
  background:conic-gradient(from 0deg at 85% 20%,transparent,rgba(255,255,255,.05),transparent 25%);
  animation:spin 14s linear infinite;
}
.profile-hero::after{ font-family:var(--display); font-weight:900; opacity:.04; right:30px; top:-30px; }
.profile-avatar{
  width:148px; height:148px; border-radius:50%; padding:4px; border:0;
  background:conic-gradient(var(--red),var(--blue),var(--red)); box-shadow:0 18px 60px rgba(255,51,71,.3);
  object-fit:cover; animation:avatarIn .9s var(--ease);
}
@keyframes avatarIn{ from{ opacity:0; transform:scale(.7) rotate(-20deg); } to{ opacity:1; transform:none; } }
.profile-avatar{ color:transparent; font-size:0; }
.profile-label{ font-size:11px; font-weight:800; letter-spacing:.2em; color:var(--red); opacity:1; }
#profileName{ font-family:var(--display); font-size:clamp(24px,3.4vw,40px); font-weight:800; letter-spacing:-.035em; line-height:1.1; margin-top:4px; }
.profile-status{ gap:10px; margin-top:14px; font-size:11.5px; font-weight:800; letter-spacing:.16em; opacity:1; color:var(--green); }
.profile-online-dot{ position:relative; background:var(--green); }
.profile-online-dot::after{ content:""; position:absolute; inset:-5px; border-radius:50%; border:1px solid var(--green); animation:ping 2.2s var(--ease) infinite; }
.profile-rank,.profile-id{ min-height:32px; padding:0 14px; border-radius:30px; font-size:11px; font-weight:800; letter-spacing:.12em; background:rgba(255,255,255,.06); border:1px solid var(--line-2); }
.profile-rank{ color:#fff; background:linear-gradient(105deg,rgba(255,51,71,.3),rgba(255,51,71,.1)); border-color:rgba(255,51,71,.5); }
.profile-id{ opacity:1; color:var(--muted); }
.profile-section{ margin-top:32px; }
.profile-eyebrow{ font-size:11px; font-weight:800; letter-spacing:.2em; color:var(--red); opacity:1; }
.profile-section-title{ font-family:var(--display); font-size:22px; font-weight:800; letter-spacing:-.03em; margin-top:6px; }
.profile-stats{ gap:14px; }
.profile-stats .stat-card{
  position:relative; min-height:0; padding:24px 20px; border-radius:var(--r-md); overflow:hidden;
  background:linear-gradient(160deg,rgba(255,255,255,.05),rgba(255,255,255,.01)); border:1px solid var(--line);
  transition:transform .4s var(--ease), border-color .3s, box-shadow .4s;
}
.profile-stats .stat-card::before{ content:""; position:absolute; left:0; top:0; width:100%; height:2px; background:linear-gradient(90deg,var(--red),var(--blue)); opacity:.7; }
.profile-stats .stat-card:hover{ transform:translateY(-5px); border-color:var(--line-2); box-shadow:0 18px 40px rgba(0,0,0,.45); }
.stat-value{ font-family:var(--display); font-size:clamp(22px,2.3vw,30px); font-weight:800; letter-spacing:-.04em; font-variant-numeric:tabular-nums; }
.profile-stats .stat-label{ margin:0 0 12px; font-size:10.5px; letter-spacing:.16em; opacity:1; color:var(--muted); }
.profile-panel{ border-radius:var(--r-lg); background:var(--panel); border:1px solid var(--line); }
.panel-head{ padding:20px 24px; background:rgba(255,255,255,.02); }
.panel-title{ font-size:11.5px; font-weight:800; letter-spacing:.16em; }
.panel-count{ font-size:10.5px; letter-spacing:.14em; opacity:1; color:var(--dim); }
.match-row{ padding:18px 24px; transition:background .25s; }
.match-row:hover{ background:rgba(255,255,255,.03); }
.match-result{ font-size:11px; letter-spacing:.14em; }
.match-result.win{ color:var(--green); text-shadow:0 0 14px rgba(53,224,138,.5); }
.side-content{ padding:10px 24px 24px; }
.side-item{ padding:15px 0; }
.side-item span{ font-size:10.5px; font-weight:800; letter-spacing:.16em; opacity:1; color:var(--muted); }
.side-item strong{ font-size:13px; font-weight:800; }
.clan-box{ margin-top:18px; padding:20px; border-radius:var(--r-md); background:linear-gradient(135deg,rgba(255,51,71,.08),rgba(47,123,255,.05)); border:1px solid var(--line-2); }
.clan-label{ font-size:10px; font-weight:800; letter-spacing:.2em; opacity:1; color:var(--muted); }
.clan-name{ font-family:var(--display); font-size:18px; letter-spacing:-.02em; margin-top:8px; }
.empty-text{ padding:46px 20px; font-size:11.5px; font-weight:800; letter-spacing:.16em; opacity:1; color:var(--dim); }

/* =========================================================
   ADMIN
   ========================================================= */

.admin-header{ margin-bottom:30px; }
.admin-header h1{ font-size:clamp(26px,3.4vw,40px); }
.admin-badge{
  padding:11px 20px; border-radius:30px; font-size:11px; font-weight:800; letter-spacing:.16em; color:#ff6677;
  background:rgba(255,51,71,.1); border:1px solid rgba(255,51,71,.4); box-shadow:0 0 30px rgba(255,51,71,.15);
}
.admin-stats{ gap:16px; margin-bottom:26px; }
.stat-box{ padding:24px; border-radius:var(--r-lg); overflow:hidden; background:linear-gradient(160deg,rgba(255,255,255,.05),rgba(255,255,255,.01)); border:1px solid var(--line); transition:transform .4s var(--ease), border-color .3s; }
.stat-box:hover{ transform:translateY(-4px); border-color:var(--line-2); }
.stat-title{ font-size:11px; font-weight:800; letter-spacing:.16em; color:var(--muted); }
.admin-stats .stat-number{ margin-top:14px; font-size:clamp(28px,3vw,40px); }
.admin-card{ border-radius:var(--r-lg); background:var(--panel); border:1px solid var(--line); }
.card-header{ padding:22px 24px; background:rgba(255,255,255,.02); }
.card-header h2{ font-family:var(--display); font-size:15px; font-weight:700; letter-spacing:-.02em; }
.card-body{ padding:8px 24px 24px; }
.admin-card table{ border:0; background:none; border-radius:0; }
.server-row{ padding:16px 0; }
.server-name{ font-weight:800; font-size:14px; }
.server-type{ font-size:12px; }
.server-status{ padding:5px 12px; border-radius:30px; font-size:10px; letter-spacing:.12em; background:rgba(255,255,255,.05); }
.server-status.online{ color:var(--green); background:rgba(53,224,138,.1); }
.server-status.offline{ color:#ff6677; background:rgba(255,51,71,.1); }
.server-status.maintenance{ color:var(--gold); background:rgba(255,200,61,.1); }

/* =========================================================
   STEAM LOGIN PAGE
   ========================================================= */

.steam-page{ min-height:calc(100vh - 0px); }
.steam-box{ position:relative; border:0; border-radius:26px; padding:clamp(30px,5vw,52px); background:var(--panel-solid); box-shadow:0 40px 100px rgba(0,0,0,.6); isolation:isolate; overflow:visible; }
.steam-box::before{
  content:""; position:absolute; inset:-1.5px; z-index:-1; border-radius:27px;
  background:conic-gradient(from var(--ang,0deg),var(--red),var(--blue),#35e08a,var(--blue),var(--red));
  animation:ang 7s linear infinite; box-shadow:0 0 80px rgba(47,123,255,.25);
}
.steam-box::after{ content:""; position:absolute; inset:0; z-index:-1; border-radius:26px; background:var(--panel-solid); opacity:1; }
@property --ang{ syntax:'<angle>'; initial-value:0deg; inherits:false; }
@keyframes ang{ to{ --ang:360deg; } }
.steam-icon{ width:82px; height:82px; margin-bottom:28px; font-family:var(--display); background:linear-gradient(145deg,#1d4a80,#0f2a4f); border:1px solid rgba(47,123,255,.5); box-shadow:0 14px 44px rgba(47,123,255,.35); animation:floaty 4.5s ease-in-out infinite; }
.steam-box h1{ font-family:var(--display); font-size:clamp(24px,3vw,32px); font-weight:800; letter-spacing:-.035em; }
.steam-box p{ font-size:15px; }
.steam-login-btn{ padding:17px 20px; border-radius:14px; font-size:13px; letter-spacing:.12em; box-shadow:0 12px 36px rgba(27,117,208,.3); }
.steam-login-btn:hover{ transform:translateY(-3px); box-shadow:0 18px 46px rgba(27,117,208,.5); }
.back-link{ font-size:13px; font-weight:700; transition:color .25s, letter-spacing .3s var(--ease); }
.back-link:hover{ letter-spacing:.06em; }

/* =========================================================
   REVEAL / STAGGER (fx.js adds classes)
   ========================================================= */

.js .reveal{ opacity:0; transform:translateY(30px); transition:opacity .8s var(--ease), transform .8s var(--ease); transition-delay:var(--d,0s); }
.js .reveal.in{ opacity:1; transform:none; }
/* safety net: if fx.js never runs, nothing stays hidden */
.js .reveal:not(.in){ animation:revealFallback .01s 3.2s forwards; }
@keyframes revealFallback{ to{ opacity:1; transform:none; } }
.stagger-in > *{ animation:staggerIn .65s var(--ease) both; animation-delay:calc(var(--i,0) * 45ms); }
@keyframes staggerIn{ from{ opacity:0; transform:translateY(22px) scale(.98); } to{ opacity:1; transform:none; } }
table .stagger-in > tr{ animation:staggerIn .55s var(--ease) both; }

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:1180px){
  .radar{ opacity:.55 !important; right:-8%; width:min(520px,60vw); }
  .hero{ max-height:none; }
}
@media(max-width:980px){
  .menu-toggle{ display:grid; }
  .topbar{ gap:12px; }
  .topbar > div:nth-of-type(2){ margin-right:auto; margin-left:14px; }

  .sidebar{
    position:fixed; left:0; top:0; z-index:1000; width:min(300px,86vw); height:100vh; height:100dvh;
    padding:26px 16px 20px; transform:translateX(-102%); overflow-y:auto; box-shadow:30px 0 80px rgba(0,0,0,.6);
  }
  .sidebar.open{ transform:none; }
  .sidebar nav{ flex-direction:column; flex-wrap:nowrap; }
  .sidebar-bottom{ margin-top:auto; padding-top:20px; }
  .nav-item.active::before{ left:-17px; }
  .main,.main-content{ margin-left:0; }
  .hero{ min-height:0; padding-top:60px; padding-bottom:80px; }
  .hero-content{ max-width:100%; }
  .stats-grid,.feature-grid{ grid-template-columns:repeat(2,1fr); }
  .stat-card:nth-child(2){ border-right:0; }
  .stat-card:nth-child(-n+2){ border-bottom:1px solid var(--line); }
  .clan-grid{ grid-template-columns:repeat(2,1fr); }
}
@media(max-width:700px){
  .topbar{ padding:0 16px; }
  .hero .radar{ opacity:.14 !important; right:-34%; width:100vw; top:70%; }
  .hero-title{ font-size:clamp(34px,11vw,56px); }
  .hero-buttons .primary-btn,.hero-buttons .secondary-btn{ flex:1 1 100%; justify-content:center; }
  .stats-grid,.feature-grid,.clan-grid{ grid-template-columns:1fr; }
  .stat-card{ border-right:0 !important; border-bottom:1px solid var(--line); }
  .stat-card:last-child{ border-bottom:0; }
  .srv-card{ height:140px; }
  .sel-bar{ top:calc(var(--topbar-h) + 6px); padding:12px; }
  .sel-pic{ width:100%; height:86px; }
  .skin-picture{ height:108px; }
  .wcard .wimg{ height:92px; }
  .search-box{ width:100%; }
  .leaderboard-table th,.players-table th,.leaderboard-table td,.players-table td{ padding:14px 12px; }
  .profile-avatar{ width:112px; height:112px; }
  .vyre-toast{ right:16px; left:16px; bottom:16px; max-width:none; }
  .system-status small{ font-size:10px; }
  footer,.footer{ flex-direction:column; align-items:flex-start; }
}

@media(hover:none){ .xhair{ display:none; } .hero{ cursor:auto; } }

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
  .js .reveal{ opacity:1; transform:none; }
  .hero-title .line > span,.hero .eyebrow,.hero p,.hero-buttons,.radar{ opacity:1 !important; transform:none !important; }
  .radar{ transform:translateY(-50%) !important; }
}


/* =========================================================
   ROUND 2 — MORE MOTION
   ========================================================= */

/* particle constellation canvas (fx.js) */
#fxCanvas{ position:fixed; inset:0; z-index:-1; pointer-events:none; }

/* page enter / leave */
.main,.main-content{ animation:pageIn .7s var(--ease) both; }
@keyframes pageIn{ from{ opacity:0; transform:translateY(16px); } to{ opacity:1; transform:none; } }
html.leaving .main,html.leaving .main-content{ opacity:0; transform:translateY(-12px); transition:opacity .26s ease, transform .26s ease; }

/* scroll progress */
.scroll-progress{ position:fixed; left:0; top:0; z-index:1100; height:3px; width:100%; transform-origin:left; transform:scaleX(var(--p,0));
  background:linear-gradient(90deg,var(--red),#ff8a5c,var(--blue)); box-shadow:0 0 16px rgba(255,51,71,.8); pointer-events:none; }

/* cursor spotlight */
.fx-spot{ position:fixed; inset:0; z-index:-1; pointer-events:none;
  background:radial-gradient(560px circle at var(--sx,50%) var(--sy,30%),rgba(255,51,71,.09),rgba(47,123,255,.05) 45%,transparent 70%); }

/* 3D tilt (variables set by fx.js) */
.tilting{ transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(-8px) !important;
  transition:transform .12s linear, border-color .3s, box-shadow .4s !important; will-change:transform; }
.tilting::before{ pointer-events:none; }

/* magnetic buttons use the independent `translate` property so they never fight hover transforms */
.primary-btn,.secondary-btn,.create-clan,.save,.steam-login,.steam-login-btn{ translate:var(--bx,0px) var(--by,0px); }

/* brand mark: living gradient ring */
.brand-mark{ isolation:isolate; }
.brand-mark::before{ content:""; position:absolute; inset:-3px; z-index:-1; border-radius:15px;
  background:conic-gradient(from 0deg,var(--red),var(--blue),#35e08a,var(--red)); animation:spin 5s linear infinite; filter:blur(.4px); opacity:.9; }
.brand-mark::after{ content:""; position:absolute; inset:0; z-index:-1; border-radius:12px; background:linear-gradient(135deg,#d9293b,#1b3f9f); }

/* active nav: light streak */
.nav-item.active{ overflow:hidden; }
.nav-item.active::after{ content:""; position:absolute; top:0; left:-40%; width:30%; height:100%; pointer-events:none;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.12),transparent); transform:skewX(-20deg); animation:streak 4.5s ease-in-out infinite; }
@keyframes streak{ 0%,55%{ left:-40%; } 100%{ left:140%; } }

/* headings: moving gradient underline + hover chroma split */
.page-header h1::after,.section-head h2::after{ background-size:220% 100%; animation:slideGrad 3.2s linear infinite; }
.section-head h2::after{ content:""; display:block; width:56px; height:3px; margin-top:14px; border-radius:3px; background-image:linear-gradient(90deg,var(--red),var(--blue),var(--red)); box-shadow:0 0 16px rgba(255,51,71,.5); }
.page-header h1::after{ background-image:linear-gradient(90deg,var(--red),var(--blue),var(--red)); }
@keyframes slideGrad{ to{ background-position:-220% 0; } }
.hero-title .line > span{ transition:text-shadow .35s; }
.hero-title:hover .line:not(.outline) > span{ text-shadow:3px 0 rgba(255,51,71,.85), -3px 0 rgba(47,123,255,.85); }

/* hero: floating HUD chips around the radar */
.hud-chip{ position:absolute; z-index:4; display:flex; flex-direction:column; gap:3px; padding:12px 16px; border-radius:14px;
  background:rgba(10,13,21,.78); border:1px solid var(--line-2); -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px);
  box-shadow:0 14px 40px rgba(0,0,0,.5); animation:chipFloat 6s ease-in-out infinite; }
.hud-chip b{ font-family:var(--display); font-size:20px; font-weight:800; letter-spacing:-.04em; color:#fff; }
.hud-chip span{ font-size:10px; font-weight:800; letter-spacing:.16em; color:var(--muted); }
.hud-chip.c1{ left:-6%; top:12%; animation-delay:-1s; }
.hud-chip.c2{ right:-4%; top:26%; animation-delay:-3s; }
.hud-chip.c3{ right:6%; bottom:6%; animation-delay:-4.5s; }
.hud-chip::before{ content:""; position:absolute; left:14px; top:-1px; width:30px; height:2px; background:linear-gradient(90deg,var(--red),transparent); }
@keyframes chipFloat{ 50%{ translate:0 -12px; } }

/* ticker strip under the hero */
.ticker{ overflow:hidden; border-bottom:1px solid var(--line); background:linear-gradient(90deg,rgba(255,51,71,.08),rgba(47,123,255,.08)); padding:16px 0; }
.ticker-track{ display:flex; width:max-content; animation:tick 34s linear infinite; }
.ticker:hover .ticker-track{ animation-play-state:paused; }
.ticker-track span{ padding-right:0; font-family:var(--display); font-weight:800; font-size:clamp(16px,2vw,24px); letter-spacing:.08em; white-space:nowrap; color:transparent; -webkit-text-stroke:1px rgba(255,255,255,.4); }
.ticker-track span em{ font-style:normal; color:var(--red); -webkit-text-stroke:0; margin:0 clamp(18px,3vw,40px); text-shadow:0 0 14px rgba(255,51,71,.8); }
@keyframes tick{ to{ transform:translateX(-50%); } }

/* weapons: idle float on the image (translate property composes with the hover scale) */
.wcard .wimg img,.skin-picture img{ animation:idle 5.5s ease-in-out infinite; }
.wcard:nth-child(2n) .wimg img,.skin-card:nth-child(2n) .skin-picture img{ animation-delay:-1.8s; }
.wcard:nth-child(3n) .wimg img,.skin-card:nth-child(3n) .skin-picture img{ animation-delay:-3.4s; }
@keyframes idle{ 50%{ translate:0 -5px; } }

/* skin rarity glow (--rar set by fx.js from the skin colour) */
.skin-card::before{ content:none; }
.skin-card:hover{ box-shadow:0 22px 46px rgba(0,0,0,.55), 0 0 36px color-mix(in srgb,var(--rar,#ff3347) 38%,transparent); border-color:color-mix(in srgb,var(--rar,#ffffff) 55%,transparent); }
.skin-card .skin-picture::after{ content:""; position:absolute; left:12%; right:12%; bottom:0; height:2px; background:linear-gradient(90deg,transparent,var(--rar,transparent),transparent); opacity:.9; }
.skin-card.selected::before{ content:"✓"; }

/* loading placeholders get a shimmer + dots */
.skel{ position:relative; overflow:hidden; color:transparent !important; min-height:120px; }
.skel::before{ content:""; position:absolute; inset:0; background:linear-gradient(100deg,transparent 25%,rgba(255,255,255,.07) 50%,transparent 75%); background-size:250% 100%; animation:shimmer 1.4s linear infinite; }
.skel::after{ content:"● ● ●"; position:absolute; left:0; right:0; top:50%; transform:translateY(-50%); text-align:center; font-size:14px; letter-spacing:.5em; color:var(--muted); animation:dots 1.2s ease-in-out infinite; }
@keyframes shimmer{ to{ background-position:-150% 0; } }
@keyframes dots{ 50%{ opacity:.25; } }

/* buttons: soft idle breathing on the main call to action */
.hero-buttons .primary-btn{ animation:fadeUp .9s 1s var(--ease) forwards, breathe 3.2s 2.2s ease-in-out infinite; }
@keyframes breathe{ 50%{ box-shadow:0 14px 46px rgba(255,51,71,.55); } }

/* stat tiles: slow gradient sweep */
.stats-grid .stat-card::before{ content:""; position:absolute; inset:0; pointer-events:none; opacity:.5;
  background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.04) 50%,transparent 70%); background-size:250% 100%; animation:shimmer 6s linear infinite; }

@media(max-width:1180px){ .hud-chip{ display:none; } }
@media(prefers-reduced-motion:reduce){
  #fxCanvas,.fx-spot,.scroll-progress{ display:none; }
  .main,.main-content{ animation:none; }
  .tilting{ transform:none !important; }
}
