  content:"◆"; display:block; margin:0 auto 20px; width:74px; height:74px; line-height:74px; border-radius:22px; font-size:30px; color:#fff;
  background:linear-gradient(135deg,rgba(255,51,71,.35),rgba(47,123,255,.3)); border:1px solid var(--line-2); box-shadow:0 14px 40px rgba(255,51,71,.2);
